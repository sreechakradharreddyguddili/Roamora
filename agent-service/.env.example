# Copy values into your PowerShell session or a local .env file (never commit secrets).
ROAMORA_AI_API_KEY=
ROAMORA_AI_MODEL=gpt-4o-mini
# OpenAI-compatible API root, not the /chat/completions endpoint.
ROAMORA_AI_BASE_URL=https://api.openai.com/v1
ROAMORA_BACKEND_URL=http://localhost:8080
ROAMORA_AGENT_HOST=127.0.0.1
ROAMORA_AGENT_PORT=8090
ROAMORA_MCP_HOST=127.0.0.1
ROAMORA_MCP_PORT=8001
ROAMORA_MCP_URL=http://127.0.0.1:8001/mcp
