# Roamora backend production/local environment
DATABASE_URL=jdbc:postgresql://localhost:5432/weatherwise
DATABASE_USERNAME=weatherwise
DATABASE_PASSWORD=change-me
REDIS_HOST=localhost
REDIS_PORT=6379

# Generate a long random secret for production.
APP_JWT_SECRET=change-me-to-a-long-random-secret
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_REFRESH_EXPIRATION_DAYS=30

# Comma-separated frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_AUTHORIZED_REDIRECT_URI=http://localhost:5173/oauth2/callback

# Optional live flight schedule provider
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1

# Optional GTFS / mobility integrations
ROAMORA_MOBILITY_DATABASE_TOKEN=

# Optional authenticated Roamora Intelligence model provider
ROAMORA_AI_ENABLED=false
ROAMORA_AI_API_KEY=
ROAMORA_AI_BASE_URL=https://api.openai.com/v1/chat/completions
ROAMORA_AI_MODEL=gpt-4o-mini

# Production travel-data providers (optional adapters; keep secrets server-side)
ROAMORA_MAP_PROVIDER=OSM
ROAMORA_MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
BOOKING_API_KEY=
BOOKING_API_BASE_URL=
EXPEDIA_API_KEY=
EXPEDIA_API_BASE_URL=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://api.amadeus.com
DUFFEL_API_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Product safety/cost controls
ROAMORA_PROVIDER_CACHE_TTL_SECONDS=900
ROAMORA_PROVIDER_DAILY_BUDGET_USD=25
ROAMORA_AI_MAX_REQUESTS_PER_MINUTE=30
