# Documentation template only: Spring Boot does not load .env files automatically.
# Set values as environment variables in the shell or your deployment platform.
# Local PostgreSQL defaults should match your Docker container.
DATABASE_URL=jdbc:postgresql://localhost:5432/weatherwise
DATABASE_USERNAME=weatherwise
DATABASE_PASSWORD=change-this-local-password
REDIS_HOST=localhost
REDIS_PORT=6379

# Replace with a long, random secret before deployment. Never commit a real secret.
APP_JWT_SECRET=replace-with-a-long-random-secret-before-deploying
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_REFRESH_EXPIRATION_DAYS=30

# Exact frontend origins; update for your deployed site.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
OAUTH2_AUTHORIZED_REDIRECT_URI=http://localhost:5173/oauth2/callback

# Optional LLM-backed Copilot. Keep the provider key on the backend only.
ROAMORA_AI_ENABLED=false
ROAMORA_AI_API_KEY=
ROAMORA_AI_BASE_URL=https://api.openai.com/v1/chat/completions
ROAMORA_AI_MODEL=gpt-4o-mini

# Optional agent-service integration. Start agent-service separately.
ROAMORA_AGENT_SERVICE_ENABLED=false
ROAMORA_AGENT_SERVICE_URL=http://localhost:8090
